{
  "extends": "../../tsconfig.next.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "paths": {
      "@flow/reader/*": [
        "apps/reader/src/*"
      ],
      "@flow/internal": [
        "packages/internal/src/index.ts"
      ],
      "@flow/epubjs/*": [
        "packages/epubjs/*"
      ],
      "@wllama/wllama": [
        "apps/reader/node_modules/@wllama/wllama/esm/index.d.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
