{
  "name": "@flow/epub-engine",
  "version": "0.6.10-lumen.1",
  "description": "Lumen-maintained browser EPUB engine, based on epub.ts",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "license": "BSD-2-Clause",
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "18.19.70",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "linkedom": "0.18.12",
    "vitest": "3.0.5"
  }
}
