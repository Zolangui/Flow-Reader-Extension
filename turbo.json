{
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "build:export": {
      "outputs": [".next/**", "out/**"],
      "env": ["FAST_BUILD", "SKIP_SENTRY", "NEXT_PUBLIC_IS_EXPORT", "ANALYZE"]
    },
    "lint": {
      "outputs": []
    },
    "dev": {}
  }
}
