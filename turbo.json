{
  "globalDependencies": [
    "pnpm-lock.yaml",
    "patches/**",
    "packages/epub-engine/src/**",
    "packages/epubjs/src/**"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "build:export": {
      "outputs": [".next/**", "out/**"],
      "env": [
        "FAST_BUILD",
        "SKIP_SENTRY",
        "NEXT_PUBLIC_IS_EXPORT",
        "NEXT_PUBLIC_LUMEN_PRESENTATION_TEST",
        "ANALYZE"
      ]
    },
    "build:export:bundle": {
      "outputs": [".next/**", "out/**"],
      "env": [
        "SKIP_SENTRY",
        "NEXT_PUBLIC_IS_EXPORT",
        "SKIP_BUILD_VALIDATION",
        "NEXT_PUBLIC_LUMEN_PRESENTATION_TEST",
        "ANALYZE"
      ]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {}
  }
}
