{
  "name": "@flow/monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.6.4+sha512.da3d715bfd22a9a105e6e8088cfc7826699332ded60c423b14ec613a185f1602206702ff0fe4c438cb15c979081ce4cb02568e364b15174503a63c7a8e2a5f6c",
  "scripts": {
    "build": "turbo run build",
    "build:reader:release": "cross-env FAST_BUILD=false SKIP_SENTRY=false node scripts/build-reader-release.js",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "build:ext:chrome": "esno scripts/build-extension.js chrome",
    "build:ext:chrome:prod": "cross-env FAST_BUILD=false SKIP_SENTRY=true esno scripts/build-extension.js chrome",
    "build:ext:firefox": "esno scripts/build-extension.js firefox",
    "build:ext:firefox:prod": "cross-env FAST_BUILD=false SKIP_SENTRY=true esno scripts/build-extension.js firefox",
    "package:chrome": "pnpm build:ext:chrome:prod && cd apps/extension/dist && bestzip ../../Lumen-chrome.zip *",
    "package:firefox": "pnpm build:ext:firefox:prod && cd apps/extension/dist && bestzip ../../Lumen-firefox.zip *",
    "benchmark:rag:report": "node scripts/rag-benchmark-report.mjs",
    "dev:ai-mock": "node scripts/ai-mock-server.cjs",
    "verify:ai-mock": "cross-env TS_NODE_PROJECT=scripts/tsconfig.esno.json esno scripts/verify-ai-mock.ts",
    "verify:providers": "cross-env TS_NODE_PROJECT=scripts/tsconfig.esno.json esno scripts/verify-providers.ts",
    "verify:ai-release": "cross-env TS_NODE_PROJECT=scripts/tsconfig.esno.json esno scripts/verify-ai-release.ts",
    "release": "pnpm -r publish --access public",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,json,css,ts,tsx,md,mdx}": "prettier --write",
    "!(pnpm-lock).{yml,yaml}": "prettier --write",
    "*.{js,ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.4.4",
    "@changesets/cli": "2.22.0",
    "@typescript-eslint/eslint-plugin": "5.19.0",
    "bestzip": "2.2.1",
    "cross-env": "7.0.3",
    "esbuild-loader": "4.4.2",
    "eslint": "8.13.0",
    "eslint-config-next": "12.1.5",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-react": "7.29.4",
    "esno": "0.14.1",
    "fs-extra": "11.3.1",
    "husky": "7.0.4",
    "lint-staged": "12.3.7",
    "prettier": "2.6.2",
    "prettier-plugin-tailwindcss": "0.1.8",
    "rimraf": "3.0.2",
    "rollup": "2.72.1",
    "rollup-plugin-dts": "4.2.1",
    "rollup-plugin-typescript2": "0.31.2",
    "sharp": "0.34.5",
    "tsup": "5.12.7",
    "turbo": "1.11.3",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.34.5",
      "zod": "4.3.6"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
